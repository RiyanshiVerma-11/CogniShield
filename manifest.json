{
  "manifest_version": 3,
  "name": "CogniShield: Cognitive Copilot & Filter-Bubble Radar",
  "version": "1.0.0",
  "description": "Zero-censorship cognitive copilot detecting filter bubbles, sensationalism, and emotional manipulation while training independent critical thinking.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "CogniShield: Critical Thinking & Digital Agency"
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.reddit.com/*",
        "*://*.bbc.com/*",
        "*://*.lemonde.fr/*",
        "*://*.spiegel.de/*",
        "*://*.theguardian.com/*",
        "*://*.reuters.com/*",
        "*://*.euractiv.com/*",
        "*://*.politico.eu/*",
        "*://*.bloomberg.com/*",
        "*://*.thehindu.com/*",
        "*://*.indianexpress.com/*"
      ],
      "js": [
        "src/shared/regex-trilingual.js",
        "src/shared/cognitive-engine.js",
        "src/shared/offline-cache.js",
        "src/shared/local-storage.js",
        "src/content/scrapers/youtube-scraper.js",
        "src/content/scrapers/twitter-scraper.js",
        "src/content/scrapers/reddit-scraper.js",
        "src/content/scrapers/news-scraper.js",
        "src/content/heatmap-highlighter.js",
        "src/content/hud-overlay.js",
        "src/content/flip-feed.js",
        "src/content/content-main.js"
      ],
      "css": [
        "src/content/hud-styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.reddit.com/*",
    "*://*.bbc.com/*",
    "*://*.lemonde.fr/*",
    "*://*.spiegel.de/*",
    "*://*.theguardian.com/*",
    "*://*.reuters.com/*",
    "*://*.euractiv.com/*",
    "*://*.politico.eu/*",
    "*://*.bloomberg.com/*",
    "*://*.thehindu.com/*",
    "*://*.indianexpress.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*",
        "src/shared/*",
        "src/dashboard/*"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.reddit.com/*"
      ]
    }
  ]
}
