# ==============================================================================
# CogniShield - Environment & API Configuration Template
# ==============================================================================
# Copy this file to `.env` (for local scripts/tests) and/or copy
# `src/config/keys.example.js` to `src/config/keys.local.js` (for Chrome Extension).
#
# NOTE: Both `.env` and `*.local.js` are gitignored to guarantee zero credential leaks.
# ==============================================================================

# Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Key (Get ultra-fast free key at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# YouTube Data API v3 Key — required for Flip the Feed real video thumbnails, channel names & direct watch links
# Get a free key: https://console.cloud.google.com/ → Enable "YouTube Data API v3" → Create API Key
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Mode Flag: set to true to force deterministic offline dossiers (0ms latency, Hamburg stage safety)
FORCE_DEMO_MODE=false
